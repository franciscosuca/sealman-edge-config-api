  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Request Path",
      "items": [
        "A caller submits a module configuration through the public FastAPI surface",
        "JWT validation and RBAC/ABAC authorization gate the operation",
        "The API stores the payload, writes desired twin state, and returns before field application completes"
      ]
    },
    {
      "dot": "violet",
      "title": "Trust Boundaries",
      "items": [
        "Caller and OIDC provider are outside the Sealman API ownership boundary",
        "Dynamic extensions expose separate public, internal, and field surfaces",
        "IoT Hub owns desired state; edge modules apply configuration and report status"
      ]
    },
    {
      "dot": "cyan",
      "title": "Supporting Runtime Detail",
      "items": [
        "Edge modules fetch the referenced JSON from Blob Storage after twin synchronization",
        "Startup runs migrations, hydrates persisted extension routes, and refreshes identity keys",
        "Periodic tasks refresh the device cache and process password-renewal work"
      ]
    }
  ]
